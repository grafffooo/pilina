{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Pilina window may do: save files the user picks in a save dialog.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-print",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$HOME/**" }, { "path": "/Volumes/**" }]
    }
  ]
}
